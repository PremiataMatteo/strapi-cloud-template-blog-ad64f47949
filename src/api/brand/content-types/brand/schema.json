{
  "kind": "singleType",
  "collectionName": "brands",
  "info": {
    "singularName": "brand",
    "pluralName": "brands",
    "displayName": "Brand"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string",
      "required": true
    },
    "piva": {
      "type": "string",
      "required": true
    },
    "Social": {
      "type": "component",
      "component": "shared.social",
      "repeatable": false
    },
    "useCart": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    }
  }
}
